#!/bin/sh
command -v git-lfs >/dev/null 2>&1 || { printf >&2 "\n%s\n\n" "This repository is configured for Git LFS but 'git-lfs' was not found on your path. If you no longer wish to use Git LFS, remove this hook by deleting the 'post-commit' file in the hooks directory (set by 'core.hookspath'; usually '.git/hooks')."; exit 2; }
git lfs post-commit "$@"

# ── Iron Rule: Service Restoration Guard ──────────────────────────────────────
# After every commit with feat/fix changes, verify services are still running.
# Runs in FOREGROUND so failures are visible and block completion declaration.
# If any service is down, auto-restores (including supervisord services).
LAST_MSG=$(git log -1 --pretty=%s 2>/dev/null || echo "")
case "$LAST_MSG" in
  feat*|fix*|refactor*)
    if [ -f "scripts/verify-services.sh" ]; then
      echo ""
      echo "[post-commit] Running service verification (Iron Rule)..."
      bash scripts/verify-services.sh
      if [ $? -ne 0 ]; then
        echo ""
        echo "⚠️  SERVICE VERIFICATION FAILED — DO NOT declare task complete!"
        echo "    Fix services before proceeding."
      fi
    fi
    ;;
esac
