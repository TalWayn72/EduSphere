# Files excluded from Prettier formatting

# Generated / vendor directories
node_modules/
dist/
build/
.turbo/
coverage/
pnpm-lock.yaml

# GraphQL codegen output — these are auto-generated; run pnpm codegen to regenerate.
# Prettier must NOT reformat these or the CI codegen-validation step will fail.
packages/graphql-types/src/generated/

# Subgraph SDL files — Prettier reformats GraphQL docstrings (single-line → multi-line)
# which causes the CI federation check to fail (SDL change without supergraph recompose).
# SDL files are already enforced via ESLint graphql plugin; Prettier adds no value here.
apps/subgraph-*/src/**/*.graphql
apps/gateway/supergraph.graphql

# Claude Code internal memory files
memory/

# Helm templates use Go template syntax ({{ }}) that trips Prettier's YAML parser
infrastructure/k8s/

# k6 load-testing files: scenarios use template placeholders (const Q = ;) that fail JS parse
infrastructure/load-testing/

# k6 NDJSON output files (one JSON object per line — invalid for Prettier's JSON parser)
tests/performance/results/
test_output.txt

# Test run artifacts — mixed output (not valid JSON/source code)
web-test-result.json
test-summary.txt
test-tail.txt

# Playwright E2E test artifacts — auto-generated by test runs, not source code
apps/web/playwright-report/
apps/web/test-results/
apps/web/visual-qa-results/

# Vite dev-server dependency cache — auto-generated, not source code
apps/web/.vite/

# Storybook static build output — auto-generated, not source code
apps/web/storybook-static/
