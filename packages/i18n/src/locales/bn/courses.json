  "deleteCourseDialogTitle": "\u0995\u09cb\u09b0\u09cd\u09b8 \u09ae\u09c1\u099b\u09c1\u09a8",
  "deleteCourseDialogDescription": "\u098f\u0987 \u0995\u09be\u099c\u099f\u09bf \u09aa\u09c2\u09b0\u09cd\u09ac\u09ac\u09a4\u09cd \u0995\u09b0\u09be \u09af\u09be\u09ac\u09c7 \u09a8\u09be\u0964 \u0995\u09cb\u09b0\u09cd\u09b8 \"{{title}}\" \u098f\u09ac\u0982 \u098f\u09b0 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1 \u09b8\u09cd\u09a5\u09be\u09af\u09bc\u09c0\u09ad\u09be\u09ac\u09c7 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u09ac\u09c7\u0964",
  "deleteCourseWarningPublished": "\u098f\u0987 \u0995\u09cb\u09b0\u09cd\u09b8\u099f\u09bf \u09ac\u09b0\u09cd\u09a4\u09ae\u09be\u09a8\u09c7 \u09aa\u09cd\u09b0\u0995\u09be\u09b6\u09bf\u09a4\u0964 \u098f\u099f\u09bf \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09b2\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09a8\u09a4\u09c1\u09a8 \u09b6\u09bf\u0995\u09cd\u09b7\u09be\u09b0\u09cd\u09a5\u09c0\u09a6\u09c7\u09b0 \u0985\u09cd\u09af\u09be\u0995\u09cd\u09b8\u09c7\u09b8 \u09b9\u09be\u09b0\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09ac\u09c7\u0964",
  "deleteCourseWarningDraft": "\u098f\u0987 \u0995\u09cb\u09b0\u09cd\u09b8\u099f\u09bf \u098f\u0995\u099f\u09bf \u0996\u09b8\u09a1\u09bc\u09be\u0964 \u098f\u099f\u09bf \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09b2\u09c7 \u09b8\u09ae\u09b8\u09cd\u09a4 \u09ae\u09a1\u09bf\u0989\u09b2 \u098f\u09ac\u0982 \u09ac\u09bf\u09b7\u09af\u09bc\u09ac\u09b8\u09cd\u09a4\u09c1 \u0986\u0987\u099f\u09c7\u09ae \u09b9\u09be\u09b0\u09bf\u09af\u09bc\u09c7 \u09af\u09be\u09ac\u09c7\u0964",
  "deleteCourseConfirmLabel": "\u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \"{{title}}\" \u099f\u09be\u0987\u09aa \u0995\u09b0\u09c1\u09a8",
  "deleteCourseConfirmMatched": "\u09b6\u09bf\u09b0\u09cb\u09a8\u09be\u09ae \u09ae\u09bf\u09b2\u09c7\u099b\u09c7 \u2014 \u098f\u0996\u09a8 \u0986\u09aa\u09a8\u09bf \u098f\u0987 \u0995\u09cb\u09b0\u09cd\u09b8\u099f\u09bf \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09a4\u09c7 \u09aa\u09be\u09b0\u09c7\u09a8\u0964",
  "deleteCourseConfirmHint": "\u09a8\u09bf\u09b6\u09cd\u099a\u09bf\u09a4 \u0995\u09b0\u09a4\u09c7 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u09b8\u09a0\u09bf\u0995 \u0995\u09cb\u09b0\u09cd\u09b8\u09c7\u09b0 \u09b6\u09bf\u09b0\u09cb\u09a8\u09be\u09ae \u099f\u09be\u0987\u09aa \u0995\u09b0\u09c1\u09a8\u0964",
  "deleteCourseFailed": "\u0995\u09cb\u09b0\u09cd\u09b8 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09ac\u09cd\u09af\u09b0\u09cd\u09a5\u0964 \u0985\u09a8\u09c1\u0997\u09cd\u09b0\u09b9 \u0995\u09b0\u09c7 \u0986\u09ac\u09be\u09b0 \u099a\u09c7\u09b7\u09cd\u099f\u09be \u0995\u09b0\u09c1\u09a8\u0964",
  "deleteCoursePermissionDenied": "\u098f\u0987 \u0995\u09cb\u09b0\u09cd\u09b8 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be\u09b0 \u0985\u09a8\u09c1\u09ae\u09a4\u09bf \u0986\u09aa\u09a8\u09be\u09b0 \u09a8\u09c7\u0987\u0964",
  "deleteCourseNotFound": "\u0995\u09cb\u09b0\u09cd\u09b8 \u09aa\u09be\u0993\u09af\u09bc\u09be \u09af\u09be\u09af\u09bc\u09a8\u09bf\u0964 \u098f\u099f\u09bf \u09b9\u09af\u09bc\u09a4\u09cb \u0987\u09a4\u09bf\u09ae\u09a7\u09cd\u09af\u09c7 \u09ae\u09c1\u099b\u09c7 \u09ab\u09c7\u09b2\u09be \u09b9\u09af\u09bc\u09c7\u099b\u09c7\u0964",
