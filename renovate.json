{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:base", ":dependencyDashboard", ":pinDigestsDisabled"],
  "schedule": ["before 6am on monday"],
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "matchDepTypes": ["devDependencies"],
      "automerge": true
    },
    {
      "matchPackagePatterns": ["*"],
      "matchUpdateTypes": ["major"],
      "labels": ["dependencies", "major-update"],
      "automerge": false
    },
    {
      "matchPackageNames": [
        "hls.js",
        "video.js",
        "@graphql-hive/*",
        "drizzle-orm"
      ],
      "stabilityDays": 7
    },
    {
      "description": "Docker base images — auto-update patch/minor with 3-day stability window",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "labels": ["dependencies", "docker"],
      "stabilityDays": 3
    },
    {
      "description": "Docker base images — major updates require manual review",
      "matchDatasources": ["docker"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "docker", "major-update"]
    }
  ],
  "ignorePaths": ["**/node_modules/**", ".claude/**"],
  "pnpm": {
    "minimumReleaseAge": "3 days"
  },
  "dockerfile": {
    "fileMatch": ["(^|/)Dockerfile[^/]*$", "(^|/)Dockerfile\\.[^/]*$"]
  }
}
