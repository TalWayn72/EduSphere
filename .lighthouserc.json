{
  "ci": {
    "collect": {
      "numberOfRuns": 3,
      "url": ["http://localhost:4173/"],
      "startServerCommand": "pnpm --filter @edusphere/web preview --port 4173",
      "startServerReadyPattern": "Local",
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --disable-gpu --ignore-certificate-errors",
        "throttling": {
          "cpuSlowdownMultiplier": 1
        },
        "skipAudits": ["redirects-http", "is-on-https"]
      }
    },
    "assert": {
      "assertions": {
        "categories:performance": [
          "warn",
          { "minScore": 0.6, "aggregationMethod": "median-run" }
        ],
        "categories:accessibility": [
          "warn",
          { "minScore": 0.85, "aggregationMethod": "median-run" }
        ],
        "categories:best-practices": [
          "warn",
          { "minScore": 0.8, "aggregationMethod": "median-run" }
        ],
        "first-contentful-paint": ["warn", { "maxNumericValue": 3000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 4500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.15 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 500 }],
        "categories:seo": "off",
        "csp-xss": "off",
        "unsized-images": "off",
        "uses-http2": "off",
        "errors-in-console": "off"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
