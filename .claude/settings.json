{
  "env": {
    "NODE_TLS_REJECT_UNAUTHORIZED": "0",
    "NODE_EXTRA_CA_CERTS": "C:\\Users\\P0039217\\.claude\\projects\\EduSphere\\infrastructure\\certs\\ca-bundle.pem"
  },
  "permissions": {
    "allow": [
      "Read(*)",
      "Write(*)",
      "Edit(*)",
      "Glob(*)",
      "Grep(*)",
      "Bash(*)",
      "Task(*)",
      "NotebookEdit(*)",
      "WebSearch(*)",
      "WebFetch(*)",
      "TodoWrite(*)",
      "Skill(*)",
      "AskUserQuestion(*)",
      "ExitPlanMode(*)",
      "EnterPlanMode(*)",
      "mcp__memory__*",
      "mcp__sequential-thinking__*",
      "mcp__eslint__*",
      "mcp__github__*",
      "mcp__tavily__*",
      "mcp__postgres__*",
      "mcp__graphql__*",
      "mcp__nats__*",
      "mcp__typescript-diagnostics__*",
      "mcp__playwright__*",
      "mcp__context7__*",
      "mcp__chrome-devtools__*"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory/session-start.sh\"",
          "timeout": 10
        }]
      },
      {
        "matcher": "compact",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory/session-resume-compact.sh\"",
          "timeout": 10
        }]
      }
    ],
    "PreCompact": [
      {
        "matcher": "auto",
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory/pre-compact.sh\"",
          "timeout": 15
        }]
      }
    ],
    "Stop": [
      {
        "hooks": [{
          "type": "command",
          "command": "bash \"$CLAUDE_PROJECT_DIR/scripts/memory/session-end.sh\"",
          "timeout": 10
        }]
      }
    ]
  }
}
