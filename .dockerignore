# Node modules
node_modules/
**/node_modules/

# Build outputs (built inside Docker, not needed in build context)
# Use **/ prefix to match nested directories (apps/web/dist/, packages/*/dist/)
**/dist/
**/build/
.next/
out/
# TypeScript incremental build info — causes nest build to skip compilation in Docker
*.tsbuildinfo
**/*.tsbuildinfo

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*

# Environment files
.env
.env.*
!.env.example

# Git
.git/
.gitignore

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Testing
**/coverage/
.nyc_output/
**/test-results/
**/playwright-report/

# Cache
.cache/
**/.turbo/
**/.vite/
.nx/

# Documentation
*.md
!README.md
docs/

# CI/CD
.github/

# Temp files
*.tmp
*.temp
*.bak

# OS
.DS_Store
Thumbs.db

# PDF and Office files
*.pdf
*.docx
